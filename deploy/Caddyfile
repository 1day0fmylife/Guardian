# DEVELOPMENT ONLY: plain HTTP on :80, no TLS, used by the root compose.yaml.
# Do not deploy this file. The production reference is deploy/service-gateway
# (separate edge and WireGuard-only service listeners, see docs/service-gateway.md).
{
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy guardian-server:8080
	}

	handle /healthz {
		reverse_proxy guardian-server:8080
	}

	handle /readyz {
		reverse_proxy guardian-server:8080
	}

	handle {
		reverse_proxy guardian-web:80
	}

	log {
		output stdout
		format json
	}
}
