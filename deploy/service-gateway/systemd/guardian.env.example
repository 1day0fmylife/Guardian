# /etc/guardian-gateway/guardian.env  (mode 0640, group guardian-gw)
GUARDIAN_DATABASE_URL=postgres://guardian:CHANGE-ME@db.internal:5432/guardian?sslmode=verify-full
GUARDIAN_PUBLIC_URL=https://guardian.example.com
GUARDIAN_ENV=production

# Sticky durable gate: do not release revoked addresses before nft acknowledgement.
GUARDIAN_SERVICE_ACL_REQUIRED=true

# Optional first superadmin, created only on an empty database; the password
# must be changed at first WebUI sign-in. Prefer a root-owned 0600 file.
#GUARDIAN_BOOTSTRAP_ADMIN_USERNAME=admin
#GUARDIAN_BOOTSTRAP_ADMIN_PASSWORD_FILE=/etc/guardian/bootstrap-admin.password
