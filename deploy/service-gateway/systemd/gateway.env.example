# /etc/guardian-gateway/gateway.env
WG_INTERFACE=wg0
WG_PORT=51820
WG_ADDRESS=10.77.0.1/24
WG_MTU=1380
WG_PRIVATE_KEY_FILE=/etc/guardian-gateway/wg-private.key
TUNNEL_CIDR=10.77.0.0/24
VIP_DNS=10.78.0.2
VIP_DAV=10.78.0.10
VIP_FLEET=10.78.0.11
VIP_ACS=10.78.0.12
DAV_FQDN=dav.internal
FLEET_FQDN=fleet.internal
ACS_FQDN=acs.internal
UPSTREAM_DAV=https://dav-backend.lan:8443
UPSTREAM_FLEET=https://fleet-backend.lan:8443
UPSTREAM_ACS=https://acs-backend.lan:8443
NFT_TABLE=guardian_gw
# Per-service upstream trust (CA bundle or the backend's leaf = pin) and the
# TLS server name that must be a SAN of the backend certificate.
UPSTREAM_DAV_TRUST=/etc/guardian-gateway/pki/dav-upstream.pem
UPSTREAM_FLEET_TRUST=/etc/guardian-gateway/pki/fleet-upstream.pem
UPSTREAM_ACS_TRUST=/etc/guardian-gateway/pki/acs-upstream.pem
UPSTREAM_DAV_SNI=dav-backend.lan
UPSTREAM_FLEET_SNI=fleet-backend.lan
UPSTREAM_ACS_SNI=acs-backend.lan
