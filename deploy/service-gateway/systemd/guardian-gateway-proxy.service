[Unit]
Description=Guardian service gateway TLS proxy (tunnel-side VIPs only)
After=guardian-gateway-network.service
Requires=guardian-gateway-network.service

[Service]
User=caddy
Group=caddy
EnvironmentFile=/etc/guardian-gateway/gateway.env
# /pki must hold gateway.crt, gateway.key and upstream-ca.pem.
ExecStart=/usr/bin/caddy run --config /etc/guardian-gateway/Caddyfile.gateway --adapter caddyfile
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=guardian-gateway-proxy
Environment=XDG_DATA_HOME=/var/lib/guardian-gateway-proxy

[Install]
WantedBy=multi-user.target
