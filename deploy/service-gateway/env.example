# Copy to state/.env (scripts/deploy.sh does this and fills the secrets).
# Names below are illustrative; they must match each service's
# internal_dns_name in the Guardian service catalog (G-01).

COMPOSE_PROJECT_NAME=guardian-gateway

# Public edge (enrollment/device channel) and management listener.
GUARDIAN_PUBLIC_HOST=guardian.example.com
GUARDIAN_MGMT_HOST=guardian-admin.example.com
# "internal" = Caddy local CA (testing). Production: an ACME e-mail address
# or "/pki/edge.crt /pki/edge.key".
EDGE_TLS=internal
PUBLIC_BIND=0.0.0.0
MGMT_BIND=127.0.0.1
GUARDIAN_PUBLIC_URL=https://guardian.example.com

# WireGuard termination.
WG_PORT=51820
WG_PUBLIC_BIND=0.0.0.0
WG_ADDRESS=10.77.0.1/24
TUNNEL_CIDR=10.77.0.0/24
WG_MTU=1380

# Service VIPs (host routes on the gateway, outside TUNNEL_CIDR). Clients
# route only VIP_NET through the tunnel: use it as the profile allowed_ips.
VIP_NET=10.78.0.0/28
VIP_DNS=10.78.0.2
VIP_DAV=10.78.0.10
VIP_FLEET=10.78.0.11
VIP_ACS=10.78.0.12

DAV_FQDN=dav.internal
FLEET_FQDN=fleet.internal
ACS_FQDN=acs.internal

# Upstreams on the private upstream network. https only; trust anchor is
# state/pki/upstream-ca.pem.
UPSTREAM_DAV=https://sunkardav:8443
UPSTREAM_FLEET=https://admiral:8443
UPSTREAM_ACS=https://sunkarcwmp-acs:8443
# Per-service trust (pin) and expected TLS server name. A trust file may be a
# CA bundle or the backend's own leaf certificate (a pin). The server name
# must be a SAN of the backend certificate.
UPSTREAM_DAV_TRUST=/pki/upstream-ca.pem
UPSTREAM_FLEET_TRUST=/pki/upstream-ca.pem
UPSTREAM_ACS_TRUST=/pki/upstream-ca.pem
UPSTREAM_DAV_SNI=sunkardav
UPSTREAM_FLEET_SNI=admiral
UPSTREAM_ACS_SNI=sunkarcwmp-acs

# Secrets (generated by scripts/deploy.sh).
POSTGRES_PASSWORD=

# Optional managed IPv4 Connection Request profile; leave all empty by default.
# CWMP_CR_SOURCE must equal VIP_ACS and the catalog connection_request source.
CWMP_CR_SOURCE=
CWMP_CR_BACKEND_ADDRESS=
CWMP_CR_BACKEND_INTERFACE=

# Required only for explicitly enabled routed CR in Docker.
CWMP_CR_IP_FORWARD=0
