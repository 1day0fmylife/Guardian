GUARDIAN_LISTEN_ADDR=:8080
GUARDIAN_DATABASE_URL=sqlite://./data/guardian.db
# Optional. Leave empty in standalone mode.
GUARDIAN_REDIS_URL=
GUARDIAN_PUBLIC_URL=http://localhost:8088
GUARDIAN_ENV=development
GUARDIAN_SESSION_TTL=12h

# Optional local WireGuard provider. Leave empty for control-plane-only mode.
# The interface must already exist and be configured with its server private key.
GUARDIAN_WIREGUARD_INTERFACE=
GUARDIAN_WIREGUARD_RECONCILE_INTERVAL=5s
GUARDIAN_WIREGUARD_RECONCILE_BATCH=100

# Optional private exporter; literal loopback IP only, never proxied by Caddy.
GUARDIAN_METRICS_LISTEN_ADDR=
# Optional single TCP connectivity probe, e.g. 10.77.0.1:443 (not TLS/auth health).
GUARDIAN_GATEWAY_PROBE_ADDRESS=
# Opt-in history retention. 0s disables it; choose a documented operational SLA.
# Positive ages are >=24h; worker prunes at most 1000 rows each hour.
GUARDIAN_TELEMETRY_RETENTION_AGE=0s
